# NoneBot2 驱动配置
# ~fastapi 提供 HTTP 服务端，~websockets 支持 WebSocket 连接
DRIVER=~fastapi+~websockets

# Bot 监听地址和端口
# NapCatQQ 的反向 WebSocket 会连接到这里
HOST=127.0.0.1
PORT=8080

# OneBot V11 适配器 WebSocket 路径
# NapCat WebUI 中 WebSocket 客户端的 URL 需要包含此路径
ONEBOT_WS_PATH=/onebot/v11/ws

# 日志级别
LOG_LEVEL=DEBUG

# SuggarChat AI 聊天插件（DeepSeek）
DEEPSEEK_API_KEY=sk-xxxxxxxxxxxxxxxx

# 跑团（CoC）：开启后意图解析与 NPC 台词走模型（同一把 key）
# 失败会自动回退规则与模板，断网也能跑
COC_LLM_ENABLED=false
# COC_LLM_MODEL=deepseek-chat
# COC_LLM_TIMEOUT=8

# nonebot-plugin-orm 数据库（suggarchat 依赖）
SQLALCHEMY_DATABASE_URL=sqlite+aiosqlite:///./data/nonebot_plugin_orm/db.sqlite3

# 帮助菜单渲染方式
# false=纯文本（默认；NapCat 等第三方协议端不渲染 json 卡片）
# true=json 卡片（仅 QQ 官方渠道机器人能正常显示）
HELP_USE_CARD=false
